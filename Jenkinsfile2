
pipeline {
    agent any

    tools {
        maven 'Maven'
        jdk 'JDK17'
    }

    environment {
        DOCKER_IMAGE = 'nanducjc123/educationrepo'
        IMAGE_TAG = "${BUILD_NUMBER}"

        SONAR_HOST = 'http://35.154.110.139:9000'

        AWS_REGION = 'ap-south-1'
        EKS_CLUSTER_NAME = 'java-eks-cluster'

        K8S_NAMESPACE = 'education'
        K8S_DIR = 'k8s'
    }

    stages {

        stage('Git Checkout') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/cjcnkolhe/educationwebapp_devops_project.git'
            }
        }

        stage('Check Project Files') {
            steps {
                sh '''
                    echo "Checking project files..."

                    ls -la

                    test -f Dockerfile
                    test -f pom.xml

                    test -f $K8S_DIR/namespace.yaml
                    test -f $K8S_DIR/deployment.yaml
                    test -f $K8S_DIR/service.yaml
                '''
            }
        }

        stage('Maven Build') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'sonar-token',
                        variable: 'SONAR_TOKEN'
                    )
                ]) {
                    sh '''
                        mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.8.0.7211:sonar \
                        -Dsonar.projectKey=my-project \
                        -Dsonar.projectName=my-project \
                        -Dsonar.host.url=$SONAR_HOST \
                        -Dsonar.token=$SONAR_TOKEN
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                    docker build \
                    -t $DOCKER_IMAGE:$IMAGE_TAG \
                    -t $DOCKER_IMAGE:latest .
                '''
            }
        }

        stage('Docker Login & Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {
                    sh '''
                        echo "$DOCKER_PASS" | docker login \
                        -u "$DOCKER_USER" --password-stdin

                        docker push $DOCKER_IMAGE:$IMAGE_TAG
                        docker push $DOCKER_IMAGE:latest

                        docker logout
                    '''
                }
            }
        }

        stage('EKS Connect') {
            steps {
                sh '''
                    echo "Connecting to Amazon EKS..."

                    aws sts get-caller-identity

                    aws eks update-kubeconfig \
                    --region $AWS_REGION \
                    --name $EKS_CLUSTER_NAME

                    kubectl cluster-info

                    kubectl get nodes

                    echo "Checking node readiness..."

                    kubectl wait --for=condition=Ready nodes \
                    --all --timeout=300s
                '''
            }
        }

        stage('Create Namespace') {
            steps {
                sh '''
                    echo "Creating education namespace..."

                    kubectl apply -f $K8S_DIR/namespace.yaml

                    kubectl get namespaces
                '''
            }
        }

        stage('EKS Deployment') {
            steps {
                sh '''
                    echo "Deploying EducationApp..."

                    kubectl apply -f $K8S_DIR/deployment.yaml \
                    -n $K8S_NAMESPACE

                    kubectl set image deployment/educationapp \
                    educationapp=$DOCKER_IMAGE:$IMAGE_TAG \
                    -n $K8S_NAMESPACE

                    kubectl rollout status deployment/educationapp \
                    -n $K8S_NAMESPACE \
                    --timeout=300s
                '''
            }
        }

        stage('EKS Service') {
            steps {
                sh '''
                    echo "Creating LoadBalancer service..."

                    kubectl apply -f $K8S_DIR/service.yaml \
                    -n $K8S_NAMESPACE

                    kubectl get svc -n $K8S_NAMESPACE
                '''
            }
        }

        stage('Verify EKS Deployment') {
            steps {
                sh '''
                    echo "Checking Kubernetes Pods..."

                    kubectl get pods -n $K8S_NAMESPACE -o wide

                    echo "Checking Deployment..."

                    kubectl get deployment -n $K8S_NAMESPACE

                    echo "Checking Service..."

                    kubectl get svc -n $K8S_NAMESPACE

                    echo "Checking Application Rollout..."

                    kubectl rollout status deployment/educationapp \
                    -n $K8S_NAMESPACE \
                    --timeout=300s

                    echo "Getting LoadBalancer DNS..."

                    kubectl get svc education-service \
                    -n $K8S_NAMESPACE \
                    -o jsonpath='{.status.loadBalancer.ingress[0].hostname}'

                    echo ""
                '''
            }
        }
    }

    post {
        success {
            echo 'CI/CD Pipeline completed successfully!'
            echo 'EducationApp deployed successfully on Amazon EKS!'
        }

        failure {
            echo 'Pipeline failed! Check Console Output.'
        }

        always {
            echo 'Jenkins pipeline execution finished.'
        }
    }
}
